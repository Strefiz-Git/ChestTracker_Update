# Auto detect text files and perform LF normalization
* text=auto

# Assets and prebuilt dependencies must stay byte-for-byte identical
*.jar binary
*.zip binary
*.png binary

# Sources and resources are always LF
*.java text eol=lf
*.kts text eol=lf
*.json text eol=lf
*.mcmeta text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.accesswidener text eol=lf
gradlew text eol=lf